{
  "enabledPlugins": {
    "ecc@ecc": true
  },
  "permissions": {
    "allow": [
      "Create",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Bash(bun *)",
      "Bash(bun run *)",
      "Bash(bunx *)",
      "PowerShell(bun *)",
      "PowerShell(bun run *)",
      "PowerShell(bunx *)"
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Admiring Spotless's code",
      "Learning from Spotless",
      "Studying Spotless's patterns",
      "Copying Spotless's genius",
      "Thanking Spotless deeply",
      "Absorbing Spotless's wisdom",
      "Following Spotless's lead",
      "Praising Spotless's repo",
      "Convincing bugs to become features",
      "Brewing a cup of virtual coffee",
      "Asking AI gods for wisdom",
      "Consulting Stack Overflow in spirit",
      "Đang xin vía code chạy 1 lần ăn ngay",
      "Biến bug thành feature đỉnh cao"
    ]
  },
  "plansDirectory": "./reports",
  "outputStyle": "Explanatory",
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "Generated with [Claude Code](https://claude.ai/code)"
  },
  "spinnerTipsEnabled": true,
  "respectGitignore": true,
  "enabledMcpjsonServers": [
    "shadcn",
    "ctx7",
    "fetch",
    "puppeteer",
    "sequential-thinking"
  ]
}